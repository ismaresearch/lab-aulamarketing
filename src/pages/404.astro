---
import Layout from '../layouts/Layout.astro';
---
<Layout titulo="Página no encontrada" descripcion="La página que buscas no existe o ha cambiado de dirección." noindex>
  <h1>No encontramos esta página</h1>
  <p class="c-lead">Puede que el enlace haya cambiado. Prueba desde aquí:</p>
  <div class="c-acciones">
    <a class="c-btn" href="/">¿Qué quieres conseguir?</a>
    <a class="c-btn c-btn--sec" href="/planes/">Ver los planes</a>
    <a class="c-btn c-btn--sec" href="/prompts/">Buscar un prompt</a>
  </div>
</Layout>
