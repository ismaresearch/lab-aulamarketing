---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import site from '../config/site.json';
import TopBar from '../components/TopBar.astro';
import TabBar from '../components/TabBar.astro';
import SideNav from '../components/SideNav.astro';
import JsonLd from '../components/JsonLd.astro';
import { abs, recortar, breadcrumbLd, ORG } from '../lib/seo';
import type { Esquema } from '../components/NavItems';

interface Props {
  titulo: string;
  descripcion?: string | null;
  jsonLd?: any[];
  migas?: { nombre: string; url?: string }[];
  esquema?: Esquema | null;
  ancho?: boolean;
  clase?: string;
  noindex?: boolean;
  tipoOg?: string;
}
const { titulo, descripcion, jsonLd = [], migas, esquema = null, ancho = false, noindex = false, tipoOg = 'website', clase } = Astro.props;
const path = Astro.url.pathname;
const canonical = abs(path);
const desc = recortar(descripcion || site.descripcion);
const tituloCompleto = path === '/' ? `${titulo} · ${site.nombre}` : `${titulo} | lab.aulamarketing.digital`;
const ld = [...jsonLd];
if (migas && migas.length > 1) ld.push(breadcrumbLd(migas));
if (path === '/') ld.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.nombre, url: site.url + '/', inLanguage: 'es-ES', publisher: ORG });
const claveModo = site.storage_key;
---
<!doctype html>
<html lang="es-ES" data-modo="ejemplo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={tipoOg} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.nombre} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#F5F5F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0F" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline define:vars={{ claveModo }}>
      try { var s = JSON.parse(localStorage.getItem(claveModo) || '{}'); if (s.modo === 'proyecto') document.documentElement.dataset.modo = 'proyecto'; } catch (e) {}
    </script>
    {ld.map((d) => <JsonLd datos={d} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="l-app">
      <SideNav esquema={esquema} />
      <div class="l-col">
        <TopBar />
        <p class="c-alerta" data-js="aviso-almacenamiento" role="status" hidden>Tu navegador no permite guardar datos. Descarga una copia de tu proyecto antes de cerrar.</p>
        <main id="contenido" class:list={['l-main', { 'l-main--ancho': ancho }, clase]} tabindex="-1">
          <slot />
          <footer class="c-footer">
            <p>Basado en «{site.libro.titulo}» ({site.libro.editorial}, {site.libro.anio}). Licencia {site.libro.licencia}. DOI <a href={site.libro.doi}>{site.libro.doi.replace('https://', '')}</a>.</p>
            <p>Tus datos se guardan solo en este navegador. <a href="/acerca/">Acerca del libro y del laboratorio</a> · <a href={site.web_principal}>aulamarketing.digital</a> · Iconos: Material Symbols (<a href="/licencias/material-symbols-LICENSE.txt">Apache 2.0</a>)</p>
          </footer>
        </main>
      </div>
    </div>
    <TabBar />
    <div id="anuncios" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    <div id="toast" class="c-toast" hidden aria-hidden="true"></div>
    <script>import '../client/app'; import '../client/piel';</script>
  </body>
</html>
